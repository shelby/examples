    "@shelby-protocol/sdk": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
